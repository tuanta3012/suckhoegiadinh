# Provide up to 6 Gemini API keys from 6 independent Google accounts (Round-Robin queue with failover on 429).
# OCR strictly uses gemini-3.5-flash-lite. Deep Analysis strictly uses gemini-3.8-flash. Chat Assistant uses gemini-3.5-flash-lite.
GEMINI_API_KEYS="YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2,YOUR_GEMINI_API_KEY_3,YOUR_GEMINI_API_KEY_4,YOUR_GEMINI_API_KEY_5,YOUR_GEMINI_API_KEY_6"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
