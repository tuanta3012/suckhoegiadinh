# Public HTTPS endpoint for the server-side Gemini integration.
# The app deliberately does not read or bundle Gemini API keys.
VITE_GEMINI_ENDPOINT=""

# Configure GEMINI_API_KEYS as a JSON array in the server-side AI Studio secret store.
# Never expose this variable to Vite builds (for example, do not rename it to VITE_GEMINI_API_KEYS).

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
