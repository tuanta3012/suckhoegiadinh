# Prefer one API key per independent Google Cloud project.
# Keep this JSON in the server's environment; never put it in a VITE_* variable.
GEMINI_PROJECTS='[{"id":"project-1","apiKey":"YOUR_GEMINI_API_KEY_1"},{"id":"project-2","apiKey":"YOUR_GEMINI_API_KEY_2"},{"id":"project-3","apiKey":"YOUR_GEMINI_API_KEY_3"},{"id":"project-4","apiKey":"YOUR_GEMINI_API_KEY_4"},{"id":"project-5","apiKey":"YOUR_GEMINI_API_KEY_5"},{"id":"project-6","apiKey":"YOUR_GEMINI_API_KEY_6"}]'

# Legacy fallback for comma/newline-separated API keys. Quotas are accounted
# separately by key, so use GEMINI_PROJECTS when project ownership is known.
# GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
