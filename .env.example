# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and OAuth callbacks.
APP_URL="MY_APP_URL"

# Required when building the Android APK/AAB. Set this to the HTTPS origin of the deployed Express API.
# Configure the same value as the GitHub Actions secret VITE_BACKEND_URL for release builds.
VITE_BACKEND_URL="https://YOUR_DEPLOYED_API_ORIGIN"

# Optional server-side Gemini API key(s) for shared Web deployment fallback.
GEMINI_API_KEY=""
