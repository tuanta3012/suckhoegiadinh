# Provide your 6 Gemini API keys separated by commas, semicolons, or newlines.
# Each key will be managed as an independent quota pool (15 RPM / 500 RPD for OCR, 5 RPM / 20 RPD for Analysis).
GEMINI_API_KEYS="YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2,YOUR_GEMINI_API_KEY_3,YOUR_GEMINI_API_KEY_4,YOUR_GEMINI_API_KEY_5,YOUR_GEMINI_API_KEY_6"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
