# Provide up to 6 Gemini API keys from independent Google accounts, separated by commas, semicolons, or newlines.
# OCR tries 3.5 Flash Lite first and uses 3.1 Flash Lite on the same key only when 3.5 fails.
# Each OCR model has its own scheduler quota of 15 RPM / 500 RPD per key.
GEMINI_API_KEYS="YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2,YOUR_GEMINI_API_KEY_3,YOUR_GEMINI_API_KEY_4,YOUR_GEMINI_API_KEY_5,YOUR_GEMINI_API_KEY_6"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
