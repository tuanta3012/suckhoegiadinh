rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authenticatedEmail() {
      return request.auth.token.email.lower();
    }

    function hasLegacyInvitation(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/invitations/$(authenticatedEmail())) &&
        get(/databases/$(database)/documents/invitations/$(authenticatedEmail())).data.familyId == familyId;
    }

    function workspaceAdmin(adminEmail) {
      return signedIn() &&
        exists(/databases/$(database)/documents/workspaceAccess/$(adminEmail)) &&
        get(/databases/$(database)/documents/workspaceAccess/$(adminEmail)).data.adminUid == request.auth.uid &&
        get(/databases/$(database)/documents/workspaceAccess/$(adminEmail)).data.role == "ADMIN" &&
        get(/databases/$(database)/documents/workspaceAccess/$(adminEmail)).data.status == "active";
    }

    function activeMember(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.status == "active";
    }

    function isAdmin(familyId) {
      return signedIn() && 
        (
          (exists(/databases/$(database)/documents/families/$(familyId)) && get(/databases/$(database)/documents/families/$(familyId)).data.adminUid == request.auth.uid)
          || (request.resource != null && request.resource.data.adminUid == request.auth.uid)
        );
    }

    match /workspaceAccess/{email} {
        allow get: if signedIn() &&
          (authenticatedEmail() == email || resource.data.adminUid == request.auth.uid);
        allow list: if signedIn() && resource.data.adminUid == request.auth.uid;
        allow create: if signedIn() &&
          request.resource.data.email == email &&
          request.resource.data.adminUid == request.auth.uid &&
          (
            (
              authenticatedEmail() == email &&
              request.resource.data.adminEmail == email &&
              request.resource.data.role == "ADMIN"
            )
            || workspaceAdmin(request.resource.data.adminEmail)
          );
        allow update: if signedIn() &&
          request.resource.data.email == email &&
          request.resource.data.adminUid == request.auth.uid &&
          (
            resource.data.adminUid == request.auth.uid ||
            (
              authenticatedEmail() == email &&
              resource.data.role == "ADMIN" &&
              request.resource.data.role == "ADMIN"
            )
          );
        allow delete: if signedIn() &&
          resource.data.adminUid == request.auth.uid &&
          resource.data.role != "ADMIN";
    }

    match /families/{familyId} {
        allow get: if activeMember(familyId) || isAdmin(familyId) || hasLegacyInvitation(familyId);
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isAdmin(familyId);
      allow delete: if isAdmin(familyId);

      match /members/{memberUid} {
        allow get: if signedIn() && (request.auth.uid == memberUid || activeMember(familyId) || isAdmin(familyId));
        allow list: if activeMember(familyId) || isAdmin(familyId);
        allow create, update: if isAdmin(familyId) || request.auth.uid == memberUid;
        allow delete: if isAdmin(familyId);
      }
    }

    match /userFamilyLinks/{uid}/families/{familyId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin(familyId));
    }

    match /invitations/{email} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Legacy support (optional, but good for transition)
    match /assigned_shares/{memberEmail} {
      allow read, write: if false; // Block legacy access once migrated
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
