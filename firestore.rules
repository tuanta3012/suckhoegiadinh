rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authenticatedEmail() {
      return request.auth.token.email.lower();
    }

    match /assigned_shares/{memberKey} {
      function isMember() {
        return signedIn()
          && (memberKey.lower() == authenticatedEmail()
              || (resource != null && resource.data.memberEmail is string && resource.data.memberEmail.lower() == authenticatedEmail()));
      }

      function isAdminForAssignment() {
        return signedIn()
          && (
            (resource != null && resource.data.adminEmail is string && resource.data.adminEmail.lower() == authenticatedEmail())
            || (request.resource != null && request.resource.data.adminEmail is string && request.resource.data.adminEmail.lower() == authenticatedEmail())
          );
      }

      function validAssignment() {
        return request.resource.data.keys().hasOnly([
            'assignedFileId', 'assignedFileName', 'familyFileId', 'adminEmail', 'memberEmail',
            'role', 'status', 'updatedAt', 'createdAt', 'source'
          ])
          && request.resource.data.assignedFileId is string
          && request.resource.data.assignedFileId.size() > 0
          && request.resource.data.adminEmail is string
          && request.resource.data.memberEmail is string
          && request.resource.data.memberEmail.size() > 0
          && request.resource.data.role is string
          && (request.resource.data.role in ['ADMIN', 'EDITOR', 'VIEWER', 'Admin', 'Editor', 'Viewer'])
          && request.resource.data.status == 'active'
          && request.resource.data.updatedAt is number;
      }

      allow get: if signedIn() && (
        memberKey.lower() == authenticatedEmail()
        || (resource != null && (resource.data.memberEmail.lower() == authenticatedEmail() || resource.data.adminEmail.lower() == authenticatedEmail()))
      );
      allow list: if signedIn();
      allow create: if signedIn() && validAssignment();
      allow update: if signedIn() && validAssignment() && (isAdminForAssignment() || isMember());
      allow delete: if signedIn() && (isAdminForAssignment() || isMember());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
