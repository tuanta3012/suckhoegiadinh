{
  "entities": {
    "HealthFamilyRegistry": {
      "title": "HealthFamilyRegistry",
      "description": "Thông tin đăng ký kho dữ liệu y tế gia đình",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "rootFolderId": { "type": "string" },
        "familyFileId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminUid": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "unlinked"] },
        "schemaVersion": { "type": "number" },
        "updatedAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["familyId", "rootFolderId", "familyFileId", "adminUid", "status"]
    },
    "HealthFamilyMember": {
      "title": "HealthFamilyMember",
      "description": "Thành viên trong gia đình",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "EDITOR", "VIEWER"] },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["memberId", "email", "role", "status"]
    },
    "UserFamilyLink": {
      "title": "UserFamilyLink",
      "description": "Liên kết người dùng với gia đình",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "unlinked"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["familyId", "status"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Lời mời tham gia gia đình",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "EDITOR", "VIEWER"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["familyId", "adminEmail", "role"]
    },
    "WorkspaceAccess": {
      "title": "WorkspaceAccess",
      "description": "Email-keyed access record for one shared Workspace",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "rootFolderId": { "type": "string" },
        "familyFileId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminUid": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "EDITOR", "VIEWER"] },
        "status": { "type": "string", "enum": ["active", "unlinked", "revoked"] },
        "schemaVersion": { "type": "number" },
        "updatedAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "migrationComplete": { "type": "boolean" },
        "source": { "type": "string", "enum": ["family_member"] }
      },
      "required": ["email", "rootFolderId", "familyFileId", "adminEmail", "adminUid", "role", "status"]
    }
  },
  "firestore": {
    "/workspaceAccess/{lowercaseEmail}": {
      "schema": "WorkspaceAccess",
      "description": "Canonical email-keyed access record for the shared Workspace"
    },
    "/families/{familyId}": {
      "schema": "HealthFamilyRegistry",
      "description": "Legacy registry retained for migration reads"
    },
    "/families/{familyId}/members/{uid}": {
      "schema": "HealthFamilyMember",
      "description": "Legacy member index retained for migration reads"
    },
    "/userFamilyLinks/{uid}/families/{familyId}": {
      "schema": "UserFamilyLink",
      "description": "Legacy UID index retained for migration reads"
    },
    "/invitations/{email}": {
      "schema": "Invitation",
      "description": "Legacy invitations imported into workspaceAccess on Admin sync"
    }
  }
}
