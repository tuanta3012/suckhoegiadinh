{
  "entities": {
    "HealthFamilyRegistry": {
      "title": "HealthFamilyRegistry",
      "description": "Thông tin đăng ký kho dữ liệu y tế gia đình",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "rootFolderId": { "type": "string" },
        "familyFileId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminUid": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "unlinked"] },
        "schemaVersion": { "type": "number" },
        "updatedAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["familyId", "rootFolderId", "familyFileId", "adminUid", "status"]
    },
    "HealthFamilyMember": {
      "title": "HealthFamilyMember",
      "description": "Thành viên trong gia đình",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "EDITOR", "VIEWER"] },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["memberId", "email", "role", "status"]
    },
    "UserFamilyLink": {
      "title": "UserFamilyLink",
      "description": "Liên kết người dùng với gia đình",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "unlinked"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["familyId", "status"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Lời mời tham gia gia đình",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "EDITOR", "VIEWER"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["familyId", "adminEmail", "role"]
    }
  },
  "firestore": {
    "/families/{familyId}": {
      "schema": "HealthFamilyRegistry",
      "description": "Thông tin gốc của gia đình"
    },
    "/families/{familyId}/members/{uid}": {
      "schema": "HealthFamilyMember",
      "description": "Danh sách thành viên chính thức"
    },
    "/userFamilyLinks/{uid}/families/{familyId}": {
      "schema": "UserFamilyLink",
      "description": "Liên kết nhanh để tìm gia đình theo người dùng"
    },
    "/invitations/{email}": {
      "schema": "Invitation",
      "description": "Lời mời chờ chấp nhận theo email"
    }
  }
}
