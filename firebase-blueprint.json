{
  "entities": {
    "AssignedShare": {
      "title": "AssignedShare",
      "description": "Bản ghi liên kết kho dữ liệu y tế gia đình duy nhất cho Admin và Thành viên",
      "type": "object",
      "properties": {
        "assignedFileId": { "type": "string" },
        "assignedFileName": { "type": "string" },
        "familyFileId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "memberEmail": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "EDITOR", "VIEWER", "Admin", "Editor", "Viewer"] },
        "status": { "type": "string", "enum": ["active"] },
        "updatedAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "source": { "type": "string", "enum": ["family_member"] }
      },
      "required": ["assignedFileId", "adminEmail", "memberEmail", "role", "status", "updatedAt"]
    }
  },
  "firestore": {
    "/assigned_shares/{memberEmail}": {
      "schema": "AssignedShare",
      "description": "Kho liên kết dữ liệu duy nhất lưu theo email của thành viên/admin"
    }
  }
}
